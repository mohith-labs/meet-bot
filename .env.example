# ── Backend ──────────────────────────────────────────
PORT=3001
JWT_SECRET=change-this-in-production
DB_PATH=/app/.data/database.sqlite
FRONTEND_URL=http://localhost:3000
BOT_NAME=MeetBot

# Google account for the bot (Playwright auth)
GOOGLE_ACCOUNT_EMAIL=
GOOGLE_ACCOUNT_PASSWORD=
AUTH_STATE_PATH=/app/.data/auth.json

# Admin account (created on first startup)
ADMIN_EMAIL=admin@meetbot.com
ADMIN_PASSWORD=admin123456
ADMIN_NAME=Admin

# Registration
REGISTRATION_ENABLED=true

# ── Cloud storage (S3) ───────────────────────────────────
# S3 upload is configured PER USER in the dashboard
# (Settings → Cloud Storage), not via env vars.
# Credentials are stored encrypted in the database using
# JWT_SECRET as the key — changing JWT_SECRET invalidates
# every saved secret access key and they must be re-entered.
#
# Where recordings are written before upload:
# STORAGE_PATH=/app/.data/recordings

# ── Frontend ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
